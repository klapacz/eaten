{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eaten",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "ai": {
    "binding": "AI"
  },
  "routes": [
    {
      "pattern": "eaten.klapacz.dev/*",
      "zone_name": "klapacz.dev"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    }
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "6ea2a84fc1c14cc5a9fba18cb770fdf8",
      "localConnectionString": "postgresql://postgres:password@localhost:54321/electric"
    }
  ]
}
